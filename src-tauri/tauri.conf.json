{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyClipboard",
  "version": "0.1.0",
  "identifier": "com.easyclipboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:client",
    "frontendDist": "../dist/client"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "clipboard",
        "title": "EasyClipboard",
        "url": "index.html?window=clipboard",
        "width": 1040,
        "height": 466,
        "minWidth": 680,
        "minHeight": 390,
        "visible": false,
        "focus": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 }
      }
    }
  }
}
